DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
AUTO_SSH_DB_TUNNEL=False
SSH_DB_HOST=kiwiki

# Optional: share production uploads when running locally (SFTP).
# Leave SFTP_HOST unset on the production server, which uses its own disk.
# DJANGO_MEDIA_URL=https://your-site.example/media/
# DJANGO_MEDIA_SFTP_HOST=your-server
# DJANGO_MEDIA_SFTP_PORT=22
# DJANGO_MEDIA_SFTP_USER=your-user
# DJANGO_MEDIA_SFTP_KEY=~/.ssh/id_ed25519
# DJANGO_MEDIA_SFTP_ROOT=/absolute/path/to/codex/media/

POSTGRES_DB=codex_db
POSTGRES_USER=codex_user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
